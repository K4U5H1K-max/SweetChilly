# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/logistics_events

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Source Settings
GDELT_ENABLED=true
GDELT_INTERVAL_MINUTES=15

PIB_ENABLED=true
PIB_INTERVAL_MINUTES=30

IMD_ENABLED=true
IMD_INTERVAL_MINUTES=15

NHAI_ENABLED=true
NHAI_INTERVAL_MINUTES=60

AAI_ENABLED=true
AAI_INTERVAL_MINUTES=60

# Processing Thresholds
RELEVANCE_THRESHOLD=0.65
LOCATION_CONFIDENCE_THRESHOLD=0.70
EVENT_SIMILARITY_THRESHOLD=0.82

# LLM Configuration
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
