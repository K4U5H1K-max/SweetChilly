# Server configuration
PORT=5000

# AI / Vision inference API key (Backend only)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# GIS Map API key (Frontend)
VITE_MAPPLS_API_KEY=

# Frontend API base URL
VITE_API_BASE_URL=http://localhost:5000

# Optional Weather telemetry API key
OPENWEATHER_API_KEY=

# ==========================================
# Track 4: Driver Safety AI Voice Subsystem
# ==========================================
# Active Voice Telephony Provider: 'mock' (default) | 'sarvam' | 'real-skeleton' | 'twilio' | 'retell' | 'vapi'
VOICE_PROVIDER=mock

# Publicly accessible backend URL for provider webhook callbacks
PUBLIC_BACKEND_URL=

# ------------------------------------------
# Sarvam AI Instant Outbound Configuration
# ------------------------------------------
# Sarvam API Key (Backend only - Never expose to frontend or git)
SARVAM_API_KEY=

# Sarvam Organization & Workspace IDs
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# Sarvam Agent Identifier & Version
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=1

# Sarvam Telephony Connection ID & Registered Caller Number (E.164)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# Webhook Callback URL registered with Sarvam
SARVAM_WEBHOOK_URL=

# Safety Guardrail: Live Telephony Activation (false = Dry-run safe mode, true = Live telephony)
SARVAM_LIVE_CALLS_ENABLED=false

# Optional comma-separated allowlist of test phone numbers permitted during staging
SARVAM_ALLOWED_TEST_NUMBERS=

# Server-side allowlist enforcement switch (true = strictly enforce allowlist, false = permit any valid vehicle.driverPhone; default is true)
ENFORCE_SARVAM_CALL_ALLOWLIST=true

# Optional webhook secret verification token
SARVAM_WEBHOOK_SECRET=

# Per-vehicle safety check call cooldown in minutes
VOICE_CALL_COOLDOWN_MINUTES=2

# Default conversation language: 'en' | 'hi' | 'as' | 'bn'
VOICE_DEFAULT_LANGUAGE=hi

